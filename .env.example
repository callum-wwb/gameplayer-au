# Server-only. Never prefix with NEXT_PUBLIC_ — SerpAPI keys must stay off the client.
SERPAPI_API_KEY=

# Neon Postgres connection string for comments and tips.
# Leave unset for local/static builds — forms show "Community is almost ready".
# Production: Vercel Storage → Neon on the gameplayer-au project, then run db/schema.sql.
DATABASE_URL=

# Shared secret for /staff/moderation (header x-moderation-secret, Bearer token, or cookie).
# Minimum 8 characters. Never expose this to the client or public nav.
MODERATION_SECRET=

# Canonical site URL used in sitemap, RSS, robots, JSON-LD, and metadataBase.
# Must be a full http(s) origin. Never leave this blank on Vercel — an empty
# string is NOT treated as unset by JavaScript `??` and will break `new URL()`.
# Production: https://www.gameplayer.com.au
# Preview: the Vercel preview URL, or the same production origin.
NEXT_PUBLIC_SITE_URL=https://www.gameplayer.com.au
